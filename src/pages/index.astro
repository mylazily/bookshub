---
import Layout from '../layouts/Layout.astro';
import { getLocale, t } from '../lib/i18n';

export const prerender = false;

const locale = getLocale(Astro.url);
const pageTitle = t(locale, 'write.title');
const pageDesc = t(locale, 'site.description');
---

<Layout title={pageTitle} description={pageDesc} locale={locale}>
  <div class="min-h-screen flex flex-col">
    <!-- Header -->
    <header class="border-b border-slate-700 bg-slate-900/80 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 h-14 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-xl">📚</span>
          <h1 class="text-lg font-bold text-white">{t(locale, 'site.name')}</h1>
        </div>
        <div class="flex items-center gap-2">
          <select id="lang-select" class="input-dark text-sm py-1.5 px-3 w-auto" onchange="window.location.search='?lang='+this.value">
            <option value="zh" selected={locale==='zh'}>中文</option>
            <option value="en" selected={locale==='en'}>English</option>
            <option value="ja" selected={locale==='ja'}>日本語</option>
            <option value="ko" selected={locale==='ko'}>한국어</option>
            <option value="es" selected={locale==='es'}>Español</option>
          </select>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col lg:flex-row max-w-7xl mx-auto w-full p-4 gap-4">
      <!-- Left Panel - Input -->
      <div class="flex-1 flex flex-col gap-4 min-w-0">
        <!-- Input Fields -->
        <div class="bg-slate-800 rounded-xl border border-slate-700 p-4 space-y-4">
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1.5">{t(locale, 'write.summary')}</label>
            <textarea id="summary" class="input-dark resize-none" rows="3" placeholder={t(locale, 'write.summaryPlaceholder')}></textarea>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1.5">{t(locale, 'write.background')}</label>
            <textarea id="background" class="input-dark resize-none" rows="3" placeholder={t(locale, 'write.backgroundPlaceholder')}></textarea>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1.5">{t(locale, 'write.plot')} <span class="text-red-400">*</span></label>
            <textarea id="plot" class="input-dark resize-none" rows="4" placeholder={t(locale, 'write.plotPlaceholder')}></textarea>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1.5">{t(locale, 'write.requirements')}</label>
            <textarea id="requirements" class="input-dark resize-none" rows="2" placeholder={t(locale, 'write.requirementsPlaceholder')}></textarea>
          </div>
        </div>

        <!-- Controls -->
        <div class="bg-slate-800 rounded-xl border border-slate-700 p-4 space-y-4">
          <div class="flex flex-wrap gap-4">
            <div class="flex-1 min-w-[140px]">
              <label class="block text-xs text-slate-400 mb-1.5">{t(locale, 'write.mode')}</label>
              <select id="mode" class="input-dark">
                <option value="normal">{t(locale, 'write.modeNormal')}</option>
                <option value="creative">{t(locale, 'write.modeCreative')}</option>
                <option value="detailed">{t(locale, 'write.modeDetailed')}</option>
              </select>
            </div>
            <div class="flex-1 min-w-[140px]">
              <label class="block text-xs text-slate-400 mb-1.5">{t(locale, 'write.length')}</label>
              <select id="length" class="input-dark">
                <option value="short">{t(locale, 'write.lengthShort')}</option>
                <option value="medium" selected>{t(locale, 'write.lengthMedium')}</option>
                <option value="long">{t(locale, 'write.lengthLong')}</option>
              </select>
            </div>
            <div class="flex-1 min-w-[140px]">
              <label class="block text-xs text-slate-400 mb-1.5">Language</label>
              <select id="output-lang" class="input-dark">
                <option value="zh" selected={locale==='zh'}>中文</option>
                <option value="en" selected={locale==='en'}>English</option>
                <option value="ja" selected={locale==='ja'}>日本語</option>
                <option value="ko" selected={locale==='ko'}>한국어</option>
                <option value="es" selected={locale==='es'}>Español</option>
              </select>
            </div>
          </div>
          
          <button id="generate-btn" class="btn-primary w-full text-base">
            <span id="btn-text">{t(locale, 'write.generate')}</span>
          </button>
        </div>
      </div>

      <!-- Right Panel - Output -->
      <div class="flex-1 flex flex-col gap-4 min-w-0">
        <div class="bg-slate-800 rounded-xl border border-slate-700 flex flex-col flex-1 min-h-[400px]">
          <div class="flex items-center justify-between px-4 py-3 border-b border-slate-700">
            <h3 class="font-semibold text-slate-200">{t(locale, 'write.output')}</h3>
            <div class="flex gap-2">
              <button id="copy-btn" class="text-slate-400 hover:text-white transition-colors p-1.5" title={t(locale, 'write.copy')}>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
              </button>
              <button id="download-btn" class="text-slate-400 hover:text-white transition-colors p-1.5" title={t(locale, 'write.download')}>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
              </button>
            </div>
          </div>
          <div id="output-area" class="flex-1 p-4 overflow-y-auto">
            <div id="empty-state" class="flex flex-col items-center justify-center h-full text-slate-500">
              <svg class="w-16 h-16 mb-4 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
              <p>{t(locale, 'write.empty')}</p>
            </div>
            <div id="loading-state" class="hidden flex-col items-center justify-center h-full">
              <div class="w-8 h-8 border-2 border-emerald-500 border-t-transparent rounded-full animate-spin mb-4"></div>
              <p class="text-slate-400">{t(locale, 'write.generating')}</p>
            </div>
            <div id="content-state" class="hidden">
              <div id="generated-content" class="prose prose-invert prose-slate max-w-none text-slate-200 leading-relaxed whitespace-pre-wrap"></div>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div id="action-buttons" class="hidden flex gap-3">
          <button id="polish-btn" class="flex-1 bg-slate-700 hover:bg-slate-600 text-white py-2.5 rounded-lg font-medium transition-colors flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
            {t(locale, 'write.polish')}
          </button>
          <button id="continue-btn" class="flex-1 bg-slate-700 hover:bg-slate-600 text-white py-2.5 rounded-lg font-medium transition-colors flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"></path></svg>
            {t(locale, 'write.continue')}
          </button>
        </div>
      </div>
    </main>
  </div>

  <script is:inline>
    (function() {
      const generateBtn = document.getElementById('generate-btn');
      const btnText = document.getElementById('btn-text');
      const outputArea = document.getElementById('output-area');
      const emptyState = document.getElementById('empty-state');
      const loadingState = document.getElementById('loading-state');
      const contentState = document.getElementById('content-state');
      const generatedContent = document.getElementById('generated-content');
      const actionButtons = document.getElementById('action-buttons');
      const copyBtn = document.getElementById('copy-btn');
      const downloadBtn = document.getElementById('download-btn');
      const polishBtn = document.getElementById('polish-btn');
      const continueBtn = document.getElementById('continue-btn');

      let currentText = '';

      function showState(state) {
        emptyState.classList.add('hidden');
        loadingState.classList.add('hidden');
        contentState.classList.add('hidden');
        if (state === 'empty') emptyState.classList.remove('hidden');
        if (state === 'loading') loadingState.classList.remove('hidden');
        if (state === 'content') contentState.classList.remove('hidden');
      }

      async function generate(type = 'generate') {
        const plot = document.getElementById('plot').value.trim();
        if (!plot) {
          alert(document.getElementById('plot').placeholder || 'Please enter the plot');
          return;
        }

        const summary = document.getElementById('summary').value.trim();
        const background = document.getElementById('background').value.trim();
        const requirements = document.getElementById('requirements').value.trim();
        const mode = document.getElementById('mode').value;
        const length = document.getElementById('length').value;
        const outputLang = document.getElementById('output-lang').value;

        generateBtn.disabled = true;
        btnText.textContent = type === 'polish' ? 'Polishing...' : type === 'continue' ? 'Continuing...' : 'Generating...';
        showState('loading');
        actionButtons.classList.add('hidden');

        try {
          let body = { summary, background, plot, requirements, mode, length, outputLang };
          
          if (type === 'polish') {
            body = { ...body, action: 'polish', text: currentText };
          } else if (type === 'continue') {
            body = { ...body, action: 'continue', previousText: currentText };
          }

          const resp = await fetch('/api/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });

          const result = await resp.json();

          if (!result.success) {
            throw new Error(result.error || 'Generation failed');
          }

          currentText = result.data;
          generatedContent.textContent = currentText;
          showState('content');
          actionButtons.classList.remove('hidden');

          // Save to history
          try {
            const history = JSON.parse(localStorage.getItem('bookshub_history') || '[]');
            history.unshift({ 
              text: currentText, 
              plot, 
              mode, 
              length, 
              timestamp: Date.now() 
            });
            if (history.length > 50) history.pop();
            localStorage.setItem('bookshub_history', JSON.stringify(history));
          } catch (e) {}

        } catch (err) {
          alert('Failed: ' + err.message);
          showState(currentText ? 'content' : 'empty');
          if (currentText) actionButtons.classList.remove('hidden');
        } finally {
          generateBtn.disabled = false;
          btnText.textContent = 'Generate';
        }
      }

      generateBtn.addEventListener('click', () => generate('generate'));
      
      polishBtn.addEventListener('click', () => generate('polish'));
      continueBtn.addEventListener('click', () => generate('continue'));

      copyBtn.addEventListener('click', () => {
        if (!currentText) return;
        navigator.clipboard.writeText(currentText).then(() => {
          copyBtn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
          setTimeout(() => {
            copyBtn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>';
          }, 1500);
        });
      });

      downloadBtn.addEventListener('click', () => {
        if (!currentText) return;
        const blob = new Blob([currentText], { type: 'text/plain' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'novel-chapter-' + new Date().toISOString().slice(0, 10) + '.txt';
        a.click();
        URL.revokeObjectURL(url);
      });
    })();
  </script>
</Layout>
